{
  "name": "messages",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @messages/crypto build && concurrently -k -n web,server \"pnpm --filter @messages/web dev\" \"pnpm --filter @messages/server dev\"",
    "dev:web": "pnpm --filter @messages/web dev",
    "dev:server": "pnpm --filter @messages/crypto build && pnpm --filter @messages/server dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
